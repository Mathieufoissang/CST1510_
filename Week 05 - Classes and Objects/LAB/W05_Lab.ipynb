  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "R-001 OK\n",
      "R-002 OVER\n",
      "R-003 OK\n"
     ]
    }
   ],
   "source": [
    "class Record:\n",
    "    def __init__(self, label, value, limit):\n",
    "        self.label = label\n",
    "        self.value = value\n",
    "        self.limit = limit\n",
    "\n",
    "    def __str__(self):\n",
    "        return f\"{self.label}: {self.value}/{self.limit}\"\n",
    "\n",
    "    def status(self):\n",
    "        if self.value > self.limit:\n",
    "            return \"OVER\"\n",
    "        else:\n",
    "            return \"OK\"\n",
    "\n",
    "\n",
    "def load_records(path):\n",
    "    result = []\n",
    "\n",
    "    with open(path, \"r\") as f:\n",
    "        for line in f:\n",
    "            if not line.strip():\n",
    "                continue\n",
    "\n",
    "            label, value, limit = line.strip().split(\",\")\n",
    "            result.append(Record(label, float(value), float(limit)))\n",
    "\n",
    "    return result\n",
    "\n",
    "\n",
    "records = load_records(\"records_sample.txt\")\n",
    "\n",
    "for record in records:\n",
    "    print(record.label, record.status())"
   ]
